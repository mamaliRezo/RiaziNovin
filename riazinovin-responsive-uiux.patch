diff --git a/frontend/src/components/layout/AppShell.jsx b/frontend/src/components/layout/AppShell.jsx
new file mode 100644
index 0000000..4715fd1
--- /dev/null
+++ b/frontend/src/components/layout/AppShell.jsx
@@ -0,0 +1,61 @@
+import HeaderDash from "../section/HeaderDash";
+import BottomMenu from "../common/BottomMenu";
+
+/**
+ * پوسته‌ی مشترک همه‌ی صفحات داخلی (داشبورد، دوره‌ها، پکیج‌ها، پروفایل...).
+ *
+ * به‌جای اینکه هر صفحه خودش هدر/فوتر رو با position:fixed و محاسبه‌ی
+ * دستی ارتفاع (headerHeight + bottomMenuHeight) پیاده کنه — که هم تکراریه
+ * هم با هر تغییر اندازه‌ی صفحه راحت به‌هم می‌ریزه — این کامپوننت با یه
+ * flex column ساده مدیریتش می‌کنه: هدر و فوتر ارتفاع طبیعی خودشون رو
+ * می‌گیرن (flex-shrink-0)، محتوا هرچقدر فضای باقی‌مونده هست رو پر می‌کنه
+ * و خودش اسکرول می‌شه (flex-1 + overflow-y-auto).
+ *
+ * عرض هم به‌جای هاردکد 412px، `w-full max-w-[412px]` هست: رو گوشی‌های
+ * باریک‌تر از 412 (خیلی از اندرویدها 360-390 هستن) جمع می‌شه و اورفلو
+ * افقی نمی‌ده؛ رو صفحه‌ی بزرگ‌تر (دسکتاپ) هم از 412 بیشتر کش نمیاد و
+ * وسط صفحه می‌مونه.
+ *
+ * showHeader/showBottomMenu برای صفحاتی مثل ComingSoon یا خطاها که
+ * نمی‌خوان منوی پایین داشته باشن.
+ */
+export default function AppShell({
+  children,
+  showHeader = true,
+  showBottomMenu = true,
+  headerHeight = 70,
+  bottomMenuHeight = 90,
+}) {
+  return (
+    <div
