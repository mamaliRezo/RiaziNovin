# این فایل رو کپی کن به اسم .env (توی همین پوشه‌ی backend) و مقادیر واقعی رو بذار توش.
# فایل .env هیچ‌وقت نباید commit بشه (توی .gitignore هست).

# یه کلید تصادفی جدید بساز، مثلاً با این دستور تو پایتون:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here

# تو محیط لوکال True بذار، رو سرور واقعی (production) حتماً False
DJANGO_DEBUG=True

# دامنه‌ها/آی‌پی‌هایی که اجازه دارن به بک‌اند وصل بشن، با کاما جدا بشن
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# اطلاعات ایمیل برای ارسال (اگه استفاده می‌کنی)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# کلید API پنل پیامک (اگه استفاده می‌کنی)
SMS_API_KEY=your-sms-api-key

# آدرس فرانت (برای ریدایرکت بعد از پرداخت)
FRONTEND_ORIGIN=http://localhost:5173

# درگاه پرداخت زرین‌پال — حالت sandbox همیشه پرداخت رو موفق نشون می‌ده،
# برای تست بدون نیاز به merchant واقعی. وقتی آماده‌ی گرفتن پول واقعی
# شدی، یه merchant id از zarinpal.com بگیر و ZARINPAL_SANDBOX=False کن.
ZARINPAL_SANDBOX=True
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
